// HRM V2 — primary schema.
//
// Designed from four inputs (see docs/database-design.md for the full
// rationale): the legacy audit (docs/legacy-*.md), the approved employee +
// HR/Admin UX already built against apps/web/src/lib/mock/*.ts, the modular
// monolith architecture, and the project's security requirements (no
// plaintext passwords, no passwords in sessions/tokens/logs, backend-enforced
// authorization, an audit trail).
//
// Deliberately NOT a port of the legacy MySQL tables — see
// docs/database-design.md for what was changed and why, and for the open
// UNKNOWNs (multi-tenancy, exact fine formula, etc.) carried over from the
// audit rather than silently guessed into the schema.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// =============================================================================
// Identity & access — separated from the Employee/HR domain by design.
// A User can exist without an Employee (future service/contractor accounts);
// every Employee requires exactly one User. Roles are many-to-many on User
// (not a single enum column) so a person can hold more than one role at once.
// =============================================================================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String
  passwordUpdatedAt DateTime  @default(now())
  isActive          Boolean   @default(true)
  // Failed-login tracking + lockout: the legacy app had neither (see
  // legacy-security-audit.md, "No rate limiting or lockout on login").
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  employee Employee?

  userRoles           UserRole[]
  sessions            Session[]
  devices             Device[]
  notifications       Notification[]
  passwordResetTokens PasswordResetToken[]

  announcementReads            AnnouncementRead[]
  approvedLeaveRequests        LeaveRequest[]       @relation("LeaveApprover")
  approvedExpenseClaims        ExpenseClaim[]       @relation("ExpenseApprover")
  decidedResignations          Resignation[]        @relation("ResignationDecider")
  verifiedDocuments            EmployeeDocument[]   @relation("DocumentVerifier")
  revisedSalaries              SalaryRevision[]     @relation("SalaryReviser")
  conductedReviews             PerformanceReview[]  @relation("ReviewConductor")
  publishedAnnouncements       Announcement[]       @relation("AnnouncementPublisher")
  editedHandbookSections       HandbookSection[]    @relation("HandbookSectionEditor")
  generatedPayslips            Payslip[]            @relation("PayslipGenerator")
  recordedAttendanceEvents     AttendanceEvent[]    @relation("AttendanceRecorder")
  assignedUserRoles            UserRole[]           @relation("UserRoleAssignedBy")
  ticketComments               TicketComment[]
  createdPolls                 Poll[]
  nominatedEmployeesOfTheMonth EmployeeOfTheMonth[]

  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  /// Stable machine key — "employee" | "manager" | "hr" | "admin" today, but
  /// a table (not a hardcoded enum) so a new role doesn't require a migration.
  key         String   @unique
  label       String
  description String?  @db.Text
  createdAt   DateTime @default(now())

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String @id @default(cuid())
  /// e.g. "leave:approve", "employee:manage", "payroll:view", "role:assign".
  key         String @unique
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId           String
  roleId           String
  assignedAt       DateTime @default(now())
  assignedByUserId String?

  user           User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedByUser User? @relation("UserRoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Device {
  id          String   @id @default(cuid())
  userId      String
  fingerprint String
  label       String?
  userAgent   String?  @db.Text
  platform    String?
  trusted     Boolean  @default(false)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions         Session[]
  attendanceEvents AttendanceEvent[]

  @@unique([userId, fingerprint])
  @@map("devices")
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  deviceId         String?
  /// Hash of the refresh token, never the raw value (rule: never store
  /// passwords/tokens in sessions — this extends the same principle to
  /// bearer tokens).
  refreshTokenHash String    @unique
  ipAddress        String?
  issuedAt         DateTime  @default(now())
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?
  revokedReason    String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("sessions")
}

/// Forgot-password flow. Mirrors Session.refreshTokenHash: only a hash of
/// the emailed token is ever persisted, never the raw value.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  ipAddress String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum AuditEventType {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  ROLE_CHANGED
  PASSWORD_CHANGED
  DOCUMENT_UPDATED
  SETTINGS_UPDATED
  EMPLOYEE_CREATED
  EMPLOYEE_UPDATED
  /// Added alongside the Users module (02) — distinct from EMPLOYEE_CREATED,
  /// which is about the HR profile, not the auth account.
  USER_CREATED
  USER_STATUS_CHANGED
  /// Added alongside the forgot-password flow (module: auth).
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  OTHER
}

/// Deliberately not FK-linked to User: an audit row (including a failed
/// login against an email with no account) must outlive and stay independent
/// of the identity record's own lifecycle. actorEmail is a point-in-time
/// snapshot, kept even if the user later changes their email.
model AuditLog {
  id          String         @id @default(cuid())
  eventType   AuditEventType
  actorUserId String?
  actorEmail  String?
  targetType  String?
  targetId    String?
  description String
  ipAddress   String?
  userAgent   String?        @db.Text
  metadata    Json?
  occurredAt  DateTime       @default(now())
  /// Snapshot of the actor's display name alongside actorEmail, since the
  /// System Logs screen shows a name and there's deliberately no FK to join
  /// through.
  actorName   String?

  @@index([actorUserId])
  @@index([occurredAt])
  @@map("audit_logs")
}

/// Generic atomic counter backing every human-facing sequential code in the
/// system (employee codes, leave/expense request codes, payslip numbers).
/// Replaces legacy's per-entity counter tables (hrm_employee_sequence,
/// invoice_numbers) with one mechanism: the application increments the row
/// for a given key inside a transaction (e.g. `UPDATE ... SET value = value
/// + 1 WHERE key = ? ` then read, or SELECT ... FOR UPDATE) and formats the
/// returned value into the display code. Avoids the "max + 1" race a plain
/// unique-code column with no backing counter would invite under concurrency.
model SequenceCounter {
  key   String @id
  value Int    @default(0)

  @@map("sequence_counters")
}

// =============================================================================
// Organization
// =============================================================================

model Department {
  id   String  @id @default(cuid())
  name String  @unique
  code String? @unique

  designations Designation[]
  employees    Employee[]

  @@map("departments")
}

model Designation {
  id           String @id @default(cuid())
  title        String
  departmentId String

  department Department @relation(fields: [departmentId], references: [id])
  employees  Employee[]

  @@unique([title, departmentId])
  @@map("designations")
}

// =============================================================================
// Employee (HR profile) — deliberately separate from User (identity/auth).
// =============================================================================

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

/// Only ACTIVE/INACTIVE are persisted. "On Leave" (shown as a directory
/// status badge in the approved UX) is intentionally NOT a stored value here
/// — it's a daily-changing fact, derived at query time from AttendanceDay /
/// LeaveRequest, the same way "on notice" would derive from Resignation.
/// Storing it as a static column (as the mock fixtures do, for demo
/// convenience) would go stale the moment a leave ends.
enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum BloodGroup {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

model Employee {
  id             String         @id @default(cuid())
  userId         String         @unique
  /// Human-facing code shown throughout the UI (e.g. "EXP-24-0118-OM").
  /// Generated by application logic, not derived from the numeric id.
  employeeCode   String         @unique
  firstName      String
  lastName       String
  personalEmail  String?
  phone          String?
  /// Needed for the "Upcoming birthdays" HR dashboard widget even though the
  /// employee Profile screen doesn't surface it directly.
  dateOfBirth    DateTime?      @db.Date
  dateOfJoining  DateTime       @db.Date
  employmentType EmploymentType @default(FULL_TIME)
  workLocation   String?
  currentAddress String?        @db.Text
  status         EmployeeStatus @default(ACTIVE)
  avatarUrl      String?
  /// The day the employee actually left - set when status flips to
  /// INACTIVE. Distinct from any Resignation.lastWorkingDay: not every
  /// past employee went through the resignation workflow (most of the
  /// legacy-imported ones didn't), so this is the one field the "Past
  /// Employees" tab can always rely on.
  dateOfExit     DateTime?      @db.Date

  /// Personal-details fields shown on the legacy HRM's profile page but
  /// absent from V2 until this addition (documented gap in
  /// database-design.md, closed on explicit request). All optional — none
  /// of them gate any workflow, and legacy data quality for these was mixed.
  gender        Gender?
  nationality   String?
  religion      String?
  maritalStatus MaritalStatus?
  bloodGroup    BloodGroup?

  departmentId  String?
  designationId String?
  managerId     String?

  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  department  Department?  @relation(fields: [departmentId], references: [id])
  designation Designation? @relation(fields: [designationId], references: [id])
  manager     Employee?    @relation("EmployeeManager", fields: [managerId], references: [id])
  reports     Employee[]   @relation("EmployeeManager")

  emergencyContacts EmployeeEmergencyContact[]
  bankDetail        EmployeeBankDetail?
  education         EmployeeEducation[]
  assets            Asset[]

  attendanceDays           AttendanceDay[]
  leaveBalances            LeaveBalance[]
  leaveRequests            LeaveRequest[]
  expenseClaims            ExpenseClaim[]
  salaryStructure          SalaryStructure?
  salaryRevisions          SalaryRevision[]
  payslips                 Payslip[]
  documents                EmployeeDocument[]
  onboardingSteps          EmployeeOnboardingStep[]
  resignations             Resignation[]
  goals                    Goal[]
  performanceReviews       PerformanceReview[]
  recognitions             Recognition[]
  tasks                    Task[]
  tickets                  Ticket[]
  moodCheckIns             MoodCheckIn[]
  pollVotes                PollVote[]
  employeeOfTheMonthAwards EmployeeOfTheMonth[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@map("employees")
}

/// Split out from Employee rather than inlined, matching the approved
/// Profile screen's "Bank & emergency" tab being a distinct sub-section.
/// One employee can have multiple contacts (legacy allows it and real
/// employees use it - see PROJECT_STATUS.md) - not @unique on employeeId.
model EmployeeEmergencyContact {
  id           String @id @default(cuid())
  employeeId   String
  name         String
  relationship String
  phone        String

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("employee_emergency_contacts")
}

/// accountNumber/panNumber must be encrypted by the application layer before
/// write (and decrypted only on authorized read) — never logged, never
/// returned in list views. Only bankLast4-equivalent display data is safe to
/// show broadly; that's derived from accountNumberEncrypted at read time, not
/// stored separately.
model EmployeeBankDetail {
  id                     String  @id @default(cuid())
  employeeId             String  @unique
  bankName               String
  accountNumberEncrypted String
  ifscCode               String
  panNumberEncrypted     String?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_bank_details")
}

/// One row per qualification. Legacy had no education table of its own —
/// it stored a single institution/field/date-range per employee directly
/// on the profile — so this is normalized into a list from the start.
model EmployeeEducation {
  id           String    @id @default(cuid())
  employeeId   String
  institution  String
  fieldOfStudy String?
  startDate    DateTime? @db.Date
  endDate      DateTime? @db.Date

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("employee_education")
}

/// Flat per-employee assignment record, matching the legacy Assets tab
/// exactly (Image / Asset ID / Asset Name / Issued date / Return date) —
/// not split into a separate asset catalog + assignment history, since
/// nothing in the approved UX needs to track an asset independent of who
/// currently holds it.
model Asset {
  id         String    @id @default(cuid())
  employeeId String
  assetTag   String    @unique
  name       String
  imageUrl   String?
  issuedDate DateTime  @db.Date
  returnDate DateTime? @db.Date

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("assets")
}

// =============================================================================
// Attendance — event-sourced, per explicit instruction. Replaces the legacy
// date1..date31 wide table (hrm_attandance_machine_detail), the separate live
// clock table (newuser_attendance), and the separate mismatch/correction
// tables with one shape: a day-level rollup fed by an immutable event log.
// =============================================================================

enum AttendanceDayStatus {
  PRESENT
  LATE
  HALF_DAY
  ABSENT
  ON_LEAVE
  HOLIDAY
  WEEKEND
}

enum AttendanceEventType {
  CHECK_IN
  CHECK_OUT
  BREAK_START
  BREAK_END
  CORRECTION
}

enum AttendanceEventSource {
  WEB
  MOBILE
  MANUAL_CORRECTION
  BIOMETRIC_IMPORT
}

/// One row per employee per calendar date — a materialized summary kept in
/// sync from AttendanceEvent rows, not hand-edited directly (a CORRECTION
/// event is how a day's summary gets amended, preserving the "why").
model AttendanceDay {
  id             String              @id @default(cuid())
  employeeId     String
  date           DateTime            @db.Date
  status         AttendanceDayStatus @default(PRESENT)
  firstCheckInAt DateTime?
  lastCheckOutAt DateTime?
  workedMinutes  Int?
  lateMinutes    Int                 @default(0)
  leaveRequestId String?
  notes          String?             @db.Text

  employee     Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveRequest LeaveRequest?     @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)
  events       AttendanceEvent[]

  @@unique([employeeId, date])
  @@index([date])
  @@map("attendance_days")
}

/// Append-only. A raw punch or correction. Nothing here is ever updated or
/// deleted — a mistaken check-in is fixed by inserting a CORRECTION event,
/// not by editing history.
model AttendanceEvent {
  id               String                @id @default(cuid())
  attendanceDayId  String
  employeeId       String
  type             AttendanceEventType
  occurredAt       DateTime
  source           AttendanceEventSource @default(WEB)
  recordedByUserId String?
  deviceId         String?
  ipAddress        String?
  note             String?               @db.Text

  attendanceDay  AttendanceDay @relation(fields: [attendanceDayId], references: [id], onDelete: Cascade)
  recordedByUser User?         @relation("AttendanceRecorder", fields: [recordedByUserId], references: [id], onDelete: SetNull)
  device         Device?       @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([employeeId, occurredAt])
  @@map("attendance_events")
}

/// National = India's gazetted holidays (Republic Day, Independence Day,
/// Gandhi Jayanti); Fixed = every other company-observed holiday
/// (festivals etc.). Not in the legacy schema - added per a direct product
/// request to classify holidays this way.
enum HolidayType {
  FIXED
  NATIONAL
}

/// Company holidays — required to resolve AttendanceDayStatus.HOLIDAY.
/// Replaces legacy's hrm_holidays (year/name/date/no_of_days/added_by) with
/// the same shape, minus added_by (audited via AuditLog instead).
model Holiday {
  id       String      @id @default(cuid())
  name     String
  date     DateTime    @db.Date
  type     HolidayType @default(FIXED)
  isActive Boolean     @default(true)

  @@unique([date])
  @@map("holidays")
}

/// Singleton (one row, fixed id) replacing the legacy office_timing global
/// row — kept as its own table rather than folded into CompanySettings since
/// it's operationally distinct (payroll/attendance calculation reads it, not
/// company profile display). Per-department schedules are not modeled: no
/// approved UX or audited business rule calls for them.
model AttendancePolicy {
  id                    String   @id @default("singleton")
  standardStartTime     DateTime @db.Time(0)
  standardEndTime       DateTime @db.Time(0)
  graceMinutes          Int      @default(15)
  halfDayThresholdHours Decimal  @default(4.5) @db.Decimal(4, 2)
  fullDayHours          Decimal  @default(9) @db.Decimal(4, 2)
  /// ISO weekday numbers (1=Mon .. 7=Sun) that count as working days.
  workingWeekdays       Json
  updatedAt             DateTime @updatedAt
  updatedByUserId       String?

  @@map("attendance_policies")
}

// =============================================================================
// Leave
// =============================================================================

enum LeaveDayType {
  FULL_DAY
  HALF_DAY
}

enum HalfDayPeriod {
  MORNING
  AFTERNOON
}

/// Shared by LeaveRequest and ExpenseClaim — both are simple submit/approve
/// workflows with the same lifecycle. Resignation keeps its own status enum
/// (adds DECLINED, not REJECTED/CANCELLED) since its workflow differs.
enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveType {
  id                  String   @id @default(cuid())
  key                 String   @unique
  name                String
  defaultAnnualDays   Decimal  @db.Decimal(4, 1)
  isPaid              Boolean  @default(true)
  requiresApproval    Boolean  @default(true)
  carryForwardAllowed Boolean  @default(false)
  carryForwardMaxDays Decimal? @db.Decimal(4, 1)
  isActive            Boolean  @default(true)

  balances LeaveBalance[]
  requests LeaveRequest[]

  @@map("leave_types")
}

/// A real balance ledger — the legacy schema had none (remaining balance was
/// computed ad hoc from LeaveType.number_of_leave minus a sum over
/// hrm_leave_applied in application code, undocumented and unauditable).
model LeaveBalance {
  id              String   @id @default(cuid())
  employeeId      String
  leaveTypeId     String
  year            Int
  allocatedDays   Decimal  @db.Decimal(4, 1)
  usedDays        Decimal  @default(0) @db.Decimal(4, 1)
  carriedOverDays Decimal  @default(0) @db.Decimal(4, 1)
  updatedAt       DateTime @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model LeaveRequest {
  id             String         @id @default(cuid())
  code           String         @unique
  employeeId     String
  leaveTypeId    String
  startDate      DateTime       @db.Date
  endDate        DateTime       @db.Date
  dayType        LeaveDayType   @default(FULL_DAY)
  halfDayPeriod  HalfDayPeriod?
  totalDays      Decimal        @db.Decimal(4, 1)
  reason         String         @db.Text
  status         RequestStatus  @default(PENDING)
  approverUserId String?
  decidedAt      DateTime?
  decisionNote   String?        @db.Text
  submittedAt    DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  employee       Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      LeaveType       @relation(fields: [leaveTypeId], references: [id])
  approverUser   User?           @relation("LeaveApprover", fields: [approverUserId], references: [id], onDelete: SetNull)
  attendanceDays AttendanceDay[]

  @@index([status])
  @@map("leave_requests")
}

// =============================================================================
// Expenses
// =============================================================================

model ExpenseCategory {
  id               String   @id @default(cuid())
  name             String   @unique
  description      String?
  /// Makes a legacy hardcoded-in-a-policy-doc rule ("internet cap ₹5,000/mo")
  /// an actual enforceable, editable value instead.
  monthlyCapAmount Decimal? @db.Decimal(10, 2)
  isActive         Boolean  @default(true)

  claims ExpenseClaim[]

  @@map("expense_categories")
}

model ExpenseClaim {
  id             String        @id @default(cuid())
  code           String        @unique
  employeeId     String
  categoryId     String
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("INR")
  expenseDate    DateTime      @db.Date
  description    String        @db.Text
  receiptUrl     String?
  status         RequestStatus @default(PENDING)
  approverUserId String?
  decidedAt      DateTime?
  decisionNote   String?       @db.Text
  submittedAt    DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  employee     Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category     ExpenseCategory @relation(fields: [categoryId], references: [id])
  approverUser User?           @relation("ExpenseApprover", fields: [approverUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("expense_claims")
}

// =============================================================================
// Payroll — replaces the legacy's two competing salary tables
// (hrm_salary_management / salary_managment) with one current-state table
// plus one append-only revision history, and replaces fixed
// earnings/deductions columns with flexible line items.
// =============================================================================

enum SalaryStatus {
  ACTIVE
  UNDER_REVIEW
}

model SalaryStructure {
  id            String       @id @default(cuid())
  employeeId    String       @unique
  currentAmount Decimal      @db.Decimal(12, 2)
  status        SalaryStatus @default(ACTIVE)
  lastRevisedAt DateTime?    @db.Date
  updatedAt     DateTime     @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("salary_structures")
}

/// Compensation changes are exactly the kind of thing that needs a
/// tamper-evident trail for compliance — added for that reason even though
/// no approved screen renders this history yet (see database-design.md).
model SalaryRevision {
  id              String   @id @default(cuid())
  employeeId      String
  previousAmount  Decimal? @db.Decimal(12, 2)
  newAmount       Decimal  @db.Decimal(12, 2)
  effectiveDate   DateTime @db.Date
  revisedByUserId String
  reason          String?  @db.Text
  createdAt       DateTime @default(now())

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  revisedByUser User     @relation("SalaryReviser", fields: [revisedByUserId], references: [id])

  @@map("salary_revisions")
}

enum PayslipStatus {
  PROCESSING
  PAID
}

model Payslip {
  id                String        @id @default(cuid())
  /// Stable sequential number (via SequenceCounter), independent of id —
  /// legacy's invoice_numbers table suggests payslips need one for financial
  /// record-keeping/compliance, not just internal identification.
  payslipNumber     String        @unique
  employeeId        String
  periodMonth       Int
  periodYear        Int
  grossAmount       Decimal       @db.Decimal(12, 2)
  netAmount         Decimal       @db.Decimal(12, 2)
  status            PayslipStatus @default(PROCESSING)
  paidAt            DateTime?
  generatedByUserId String?
  generatedAt       DateTime      @default(now())

  employee        Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  generatedByUser User?             @relation("PayslipGenerator", fields: [generatedByUserId], references: [id], onDelete: SetNull)
  lineItems       PayslipLineItem[]

  @@unique([employeeId, periodMonth, periodYear])
  @@map("payslips")
}

enum PayslipLineItemType {
  EARNING
  DEDUCTION
}

model PayslipLineItem {
  id        String              @id @default(cuid())
  payslipId String
  type      PayslipLineItemType
  label     String
  amount    Decimal             @db.Decimal(12, 2)
  sortOrder Int                 @default(0)

  payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)

  @@map("payslip_line_items")
}

// =============================================================================
// Operating expenses — recurring non-salary company costs (rent, utilities)
// that Payroll reports needs to show alongside payroll cost. One row per
// category per period, not a "recurring template with an override": rent
// and internet can change too, and electricity varies every month by
// definition, so every period is entered explicitly rather than assumed.
// =============================================================================

enum OperatingExpenseCategory {
  RENT
  ELECTRICITY
  INTERNET
  MISCELLANEOUS
  /// User-added line item beyond the 4 standard categories — `label` names
  /// it. Unlike the standard 4 (fixed, one row per period), any number of
  /// CUSTOM rows can exist per period, distinguished by label.
  CUSTOM
}

model OperatingExpense {
  id          String                   @id @default(cuid())
  category    OperatingExpenseCategory
  /// Empty for the 4 standard categories (kept non-null so the unique
  /// constraint below still enforces one row per category per period —
  /// MySQL treats NULLs in a unique index as distinct from each other,
  /// which would defeat that). Required, user-entered text for CUSTOM.
  label       String                   @default("")
  amount      Decimal                  @db.Decimal(12, 2)
  periodMonth Int
  periodYear  Int
  note        String?                  @db.Text
  updatedAt   DateTime                 @updatedAt

  @@unique([category, label, periodMonth, periodYear])
  @@map("operating_expenses")
}

// =============================================================================
// Documents — one clean table replacing three overlapping legacy systems
// (hrm_employee_documents, emp_documents' fixed columns, and the disconnected
// hrm_employee_document_proof).
// =============================================================================

enum DocumentCategory {
  IDENTITY
  EDUCATION
  BANKING
  EMPLOYMENT
}

model DocumentType {
  id       String           @id @default(cuid())
  key      String           @unique
  name     String
  category DocumentCategory

  employeeDocuments EmployeeDocument[]

  @@map("document_types")
}

enum EmployeeDocumentStatus {
  VERIFIED
  PENDING_REVIEW
  MISSING
  REJECTED
}

model EmployeeDocument {
  id               String                 @id @default(cuid())
  employeeId       String
  documentTypeId   String
  fileUrl          String?
  status           EmployeeDocumentStatus @default(MISSING)
  uploadedAt       DateTime?
  verifiedByUserId String?
  verifiedAt       DateTime?
  notes            String?                @db.Text

  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  documentType   DocumentType @relation(fields: [documentTypeId], references: [id])
  verifiedByUser User?        @relation("DocumentVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@unique([employeeId, documentTypeId])
  @@map("employee_documents")
}

// =============================================================================
// Onboarding — the legacy checklist-with-attachments pattern here was
// already reasonably modeled; kept, minus the file-attachment table (no
// approved UX surfaces per-step file uploads yet).
// =============================================================================

model OnboardingStepTemplate {
  id        String  @id @default(cuid())
  name      String
  sortOrder Int
  isActive  Boolean @default(true)

  employeeSteps EmployeeOnboardingStep[]

  @@map("onboarding_step_templates")
}

model EmployeeOnboardingStep {
  id             String    @id @default(cuid())
  employeeId     String
  stepTemplateId String
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?

  employee     Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  stepTemplate OnboardingStepTemplate @relation(fields: [stepTemplateId], references: [id])

  @@unique([employeeId, stepTemplateId])
  @@map("employee_onboarding_steps")
}

// =============================================================================
// Resignation — own status enum (adds DECLINED). Offboarding step checklists
// are not modeled: no approved UX covers them yet (see database-design.md).
// =============================================================================

enum ResignationStatus {
  PENDING
  APPROVED
  DECLINED
  /// Added alongside the Resignation module (14) — self-service withdrawal
  /// updates status rather than deleting the row, consistent with every
  /// other domain in this schema never destroying decision history.
  WITHDRAWN
}

model Resignation {
  id               String            @id @default(cuid())
  employeeId       String
  reason           String            @db.Text
  submittedAt      DateTime          @default(now())
  lastWorkingDay   DateTime          @db.Date
  noticePeriodDays Int
  status           ResignationStatus @default(PENDING)
  decidedByUserId  String?
  decidedAt        DateTime?
  decisionNote     String?           @db.Text

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  decidedByUser User?    @relation("ResignationDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@map("resignations")
}

// =============================================================================
// Mood check-in — a once-a-day "how are you feeling" popup shown on login.
// =============================================================================

enum MoodLevel {
  TERRIBLE
  POOR
  GOOD
  GREAT
  EXCELLENT
}

/// One row per day an employee has *handled* the popup — either answered
/// it (`mood` set) or dismissed it with the X (`mood` null). The null rows
/// exist purely so the popup doesn't reappear later the same day; they're
/// filtered out of "my past moods" history, which only shows real answers.
model MoodCheckIn {
  id          String     @id @default(cuid())
  employeeId  String
  date        DateTime   @db.Date
  mood        MoodLevel?
  /// Fixed tag set (Appraisal Salary, Colleagues, Work-life balance, …) —
  /// no relational querying need, so a plain string array rather than a
  /// join table (same reasoning as AttendancePolicy.workingWeekdays).
  tags        Json?
  comment     String?    @db.Text
  isAnonymous Boolean    @default(false)
  createdAt   DateTime   @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@map("mood_checkins")
}

// =============================================================================
// Polls — admin-created, single-choice, company-wide. No status column and
// no scheduled job to flip one: "open" is simply `endsAt > now`, computed
// at query time (same reasoning as ReviseSalary's effectiveDate rejection —
// this app has no scheduled-job infrastructure, so state that depends on
// wall-clock time is always derived, never stored and flipped by a cron).
// Results are withheld from the employee-facing read until closed; nothing
// in the schema enforces that, it's a service-layer rule.
// =============================================================================

model Poll {
  id              String   @id @default(cuid())
  question        String
  createdByUserId String
  createdAt       DateTime @default(now())
  endsAt          DateTime

  createdByUser User         @relation(fields: [createdByUserId], references: [id])
  options       PollOption[]
  votes         PollVote[]

  @@map("polls")
}

model PollOption {
  id        String @id @default(cuid())
  pollId    String
  label     String
  sortOrder Int    @default(0)

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@map("poll_options")
}

/// One vote per employee per poll, permanent - PollsService.vote() rejects
/// a second attempt outright rather than allowing a change of mind.
model PollVote {
  id         String   @id @default(cuid())
  pollId     String
  optionId   String
  employeeId String
  votedAt    DateTime @default(now())

  poll     Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option   PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  employee Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([pollId, employeeId])
  @@map("poll_votes")
}

// =============================================================================
// Performance
// =============================================================================

model PerformanceCycle {
  id        String   @id @default(cuid())
  name      String   @unique
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  isActive  Boolean  @default(true)

  goals   Goal[]
  reviews PerformanceReview[]

  @@map("performance_cycles")
}

model Goal {
  id              String    @id @default(cuid())
  employeeId      String
  cycleId         String
  title           String
  progressPercent Int       @default(0)
  dueDate         DateTime? @db.Date

  employee Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycle    PerformanceCycle @relation(fields: [cycleId], references: [id])

  @@map("goals")
}

model PerformanceReview {
  id               String   @id @default(cuid())
  employeeId       String
  cycleId          String
  rating           Decimal  @db.Decimal(3, 2)
  maxRating        Int      @default(5)
  summary          String   @db.Text
  reviewedByUserId String
  reviewedAt       DateTime @default(now())

  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycle          PerformanceCycle @relation(fields: [cycleId], references: [id])
  reviewedByUser User             @relation("ReviewConductor", fields: [reviewedByUserId], references: [id])

  @@map("performance_reviews")
}

/// source is free text ("Peer nomination", a person's name) rather than an
/// FK — the approved Performance screen mixes program-level and
/// person-given recognitions, and modeling a full nomination/voting system
/// (as the legacy eom/eom_votes tables did) is out of scope: no approved UX
/// calls for it.
model Recognition {
  id         String   @id @default(cuid())
  employeeId String
  title      String
  source     String
  awardedAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("recognitions")
}

/// Requested directly (2026-09-09) as its own concept, not folded into the
/// free-text Recognition model above - one admin-picked employee per
/// calendar month (upsert on the unique key replaces that month's pick if
/// changed), not a vote/nomination system (the legacy eom/eom_votes tables'
/// approach, deliberately not ported - see Recognition's own comment).
model EmployeeOfTheMonth {
  id                String   @id @default(cuid())
  employeeId        String
  periodMonth       Int
  periodYear        Int
  note              String?  @db.Text
  nominatedByUserId String
  nominatedAt       DateTime @default(now())

  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  nominatedByUser User     @relation(fields: [nominatedByUserId], references: [id])

  @@unique([periodMonth, periodYear])
  @@map("employee_of_the_month")
}

// =============================================================================
// Tasks — explicitly required My Day content ("Today's tasks", with a done
// checkbox in the built UI, so this is per-employee actionable state, not a
// purely derived value). "Today's meetings" is deliberately NOT modeled here
// — see database-design.md: it plausibly belongs to a calendar integration
// (Google Calendar/Outlook), not a locally-authored table.
// =============================================================================

model Task {
  id         String    @id @default(cuid())
  employeeId String
  title      String
  dueDate    DateTime? @db.Date
  isDone     Boolean   @default(false)
  createdAt  DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, isDone])
  @@map("tasks")
}

// =============================================================================
// Announcements & notifications
// =============================================================================

enum AnnouncementCategory {
  HOLIDAY
  POLICY
  EVENT
  GENERAL
}

model Announcement {
  id                String               @id @default(cuid())
  title             String
  body              String               @db.Text
  imageUrl          String?
  category          AnnouncementCategory
  publishedByUserId String
  publishedAt       DateTime             @default(now())

  publishedByUser User               @relation("AnnouncementPublisher", fields: [publishedByUserId], references: [id])
  reads           AnnouncementRead[]

  @@map("announcements")
}

/// A single named section of the company HR handbook (Working Hours, Leave
/// Policy, Code of Conduct, ...), shown in a fixed order to every employee.
/// Plain text body (no markdown/rich-text rendering exists in this app yet -
/// matches Announcement.body) - rendered with `whitespace-pre-wrap` on the
/// frontend, editable in place by hr/admin.
model HandbookSection {
  id              String   @id @default(cuid())
  title           String
  body            String   @db.Text
  order           Int
  updatedAt       DateTime @updatedAt
  updatedByUserId String?

  updatedByUser User? @relation("HandbookSectionEditor", fields: [updatedByUserId], references: [id])

  @@map("handbook_sections")
}

/// Per-viewer read state — the legacy `announcement.status`-style single
/// boolean is wrong because "read" is a fact about a reader, not the
/// announcement; this table makes that explicit instead of reproducing it.
model AnnouncementRead {
  id             String   @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@map("announcement_reads")
}

/// Stable keys, not the legacy prose labels ("Recruitment / Joining") — the
/// frontend holds a display-label map, same shape as ATTENDANCE_BUCKET_LABEL.
enum TicketCategory {
  SALARY_OR_PAYMENT
  LEAVE_OR_ATTENDANCE
  OFFICE_FACILITIES
  GENERAL_QUERIES
  RECRUITMENT_OR_JOINING
  EXIT_FORMALITIES
  COMPLAINT
  MISPUNCH
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

/// Four states, not the three the request described (Open/Under
/// Progress/Closed) — RESOLVED is kept because it's real: legacy has ~90
/// historical tickets sitting in that state and dropping it would make them
/// unmappable. RESOLVED and CLOSED both render green (see
/// TICKET_STATUS_TONE on the frontend) so the requested 3-color scheme
/// (red/orange/green) still holds at a glance.
enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Ticket {
  id          String         @id @default(cuid())
  /// Human-facing code shown throughout the UI (e.g. "TKT-0042").
  code        String         @unique
  employeeId  String
  category    TicketCategory
  title       String
  description String         @db.Text
  priority    TicketPriority @default(MEDIUM)
  status      TicketStatus   @default(OPEN)
  resolvedAt  DateTime?
  closedAt    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  employee Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  comments TicketComment[]

  @@index([status])
  @@index([employeeId])
  @@map("tickets")
}

/// Single flat thread per ticket (matches the legacy "Add a Comment" /
/// "Submit Comment" feature) — no threading/replies, HR and the raising
/// employee both post into the same list.
model TicketComment {
  id           String   @id @default(cuid())
  ticketId     String
  authorUserId String
  body         String   @db.Text
  createdAt    DateTime @default(now())

  ticket     Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUser User   @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@map("ticket_comments")
}

enum NotificationType {
  LEAVE
  EXPENSE
  ATTENDANCE
  ANNOUNCEMENT
  SYSTEM
  BIRTHDAY
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  description String           @db.Text
  linkUrl     String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// =============================================================================
// Company settings — single-tenant by deliberate decision (see
// database-design.md: the legacy schema had three unrelated, inconsistently
// wired "company" tables and the audit flagged multi-tenancy as an
// unconfirmed requirement; a real Company/tenant root is not added on
// speculation). updatedByUserId is a plain reference, not an FK, to avoid a
// singleton-table back-relation array on User for a field with no
// integrity-critical downstream use.
// =============================================================================

model CompanySettings {
  id              String   @id @default("singleton")
  legalName       String
  brandName       String
  website         String?
  supportEmail    String
  phone           String?
  address         String?  @db.Text
  timezone        String   @default("Asia/Kolkata")
  updatedAt       DateTime @updatedAt
  updatedByUserId String?

  @@map("company_settings")
}
