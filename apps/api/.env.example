# Local development only. Copy this file to .env and fill in real values.
# NEVER point DATABASE_URL at the production HRM database.

DATABASE_URL="mysql://hrm_v2:hrm_v2_dev_password@localhost:3307/hrm_v2_dev"
REDIS_URL="redis://localhost:6380"

PORT=3001
NODE_ENV=development

# JWT / session secrets — generate local-only values, never reuse production secrets.
JWT_ACCESS_SECRET="replace-with-local-dev-secret"
JWT_REFRESH_SECRET="replace-with-local-dev-secret"
