# Local development only. Copy this file to .env and fill in real values.
# NEVER point DATABASE_URL at the production HRM database.

DATABASE_URL="mysql://hrm_v2:hrm_v2_dev_password@localhost:3307/hrm_v2_dev"
REDIS_URL="redis://localhost:6380"

PORT=3001
NODE_ENV=development

# The one origin CORS accepts (see main.ts) — the frontend's dev server URL.
WEB_ORIGIN="http://localhost:3000"

# Signs access tokens (JWT). Generate a local-only value (32+ chars),
# never reuse a production secret. e.g.: openssl rand -hex 48
JWT_ACCESS_SECRET="replace-with-a-local-dev-secret-at-least-32-characters-long"

# No JWT_REFRESH_SECRET: refresh tokens are opaque random values (not JWTs),
# stored only as a sha256 hash in Session.refreshTokenHash — see
# apps/api/src/auth/auth.service.ts. Nothing verifies a refresh token's
# signature, so there's no secret to configure for it.

# AES-256 key for at-rest encryption of PII (EmployeeBankDetail.*Encrypted),
# raw 32 bytes hex-encoded — must be exactly 64 hex characters.
# Generate a local-only value: openssl rand -hex 32
ENCRYPTION_KEY="replace-with-64-hex-characters-32-raw-bytes-0000000000000000000"

# Outbound mail (forgot-password today, more later — see mail/mail.service.ts).
# Leave all of these unset for local dev; emails just get logged instead of sent.
#
# Microsoft Graph (preferred in production — works regardless of the mailbox's
# MFA/Basic-Auth-SMTP settings). Needs an Azure app registration with the
# Mail.Send *application* permission and admin consent granted.
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_SENDER_EMAIL=hr@1solutions.biz
#
# SMTP fallback, only used if the Graph vars above aren't all set.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="1Solutions HRM <hr@1solutions.biz>"
