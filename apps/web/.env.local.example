# Local development only. Copy this file to .env.local and adjust if needed.

# Base URL of the NestJS API (apps/api). Defaults to http://localhost:3001
# if unset — this only needs to be set when the API runs somewhere else.
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Web Push public key (not a secret - browsers need it to subscribe).
# Must match VAPID_PUBLIC_KEY in apps/api's env exactly. Leave unset to
# disable the "Enable push notifications" toggle in Settings.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
